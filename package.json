{
  "name": "ugc-creative-ops",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "turbo db:generate --filter=@ugc/api",
    "db:migrate": "turbo db:migrate --filter=@ugc/api",
    "test:e2e": "pnpm --filter @ugc/e2e test",
    "test:e2e:headed": "pnpm --filter @ugc/e2e test:headed"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
